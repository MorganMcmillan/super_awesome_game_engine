// Editor support for game scripts (Pylance and pyright read this file).
// The sage package lives in python/sage; scripts
// import `world` with `from sage import world`.
{
  "include": ["python", "examples"],
  "exclude": ["**/__pycache__", "target"],
  "pythonVersion": "3.12",
  // Pylance's default: completions, hovers and undefined names, no strict
  // type errors. Under "standard", expect reports that are true but noisy for
  // scripts: `world.lookup` and `entity.get` may return None.
  "typeCheckingMode": "off",
  // sage._ecs is native; its stub has no Python source by design.
  "reportMissingModuleSource": "none",
  "extraPaths": ["python"],
  "executionEnvironments": [{ "root": ".", "extraPaths": ["python"] }]
}
