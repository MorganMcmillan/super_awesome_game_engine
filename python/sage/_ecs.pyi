# Type stub for `sage._ecs`, the native half of the Flecs binding
# (crates/sage_ecs_py/src/api.rs and value.rs). Editors read this; the engine
# never does. Keep it in step with the #[pymethods] there. Underscored
# methods are internal to `sage.ecs` and are left out.

from typing import Any, Self, TypeVar

# Not bound to Value: `@component` classes do not subclass it as far as a
# type checker can tell.
_T = TypeVar("_T")

class Value:
    """Storage for one component value: owned, or a view into the world."""

    def __new__(cls, *args: Any, **kwargs: Any) -> Self: ...
    def _alloc(self, size: int) -> None: ...
    @property
    def is_view(self) -> bool: ...
    @property
    def is_valid(self) -> bool:
        """False once a view's callback has returned or the world changed
        structure."""

class Field:
    """Descriptor for one reflected field of a component class."""

    def __get__(self, obj: Value | None, owner: type | None = None) -> Any: ...
    def __set__(self, obj: Value, value: Any) -> None: ...
    @property
    def kind(self) -> str: ...
    @property
    def offset(self) -> int: ...

class Entity:
    @property
    def id(self) -> int:
        """The Flecs id. Not stable across runs; use `sid` for that."""
    @property
    def sid(self) -> int | None:
        """The StableId, if the entity has one."""
    @property
    def name(self) -> str | None: ...
    @property
    def path(self) -> str: ...
    @property
    def is_alive(self) -> bool: ...
    @property
    def parent(self) -> Entity | None: ...
    @property
    def enabled(self) -> bool: ...
    def set(self, value: object) -> Self:
        """Sets a component value (copied in). Returns the entity for chaining."""
    def add(self, what: type[Any] | Entity, target: type[Any] | Entity | None = None) -> Self:
        """Adds a tag, a component (zeroed, then its defaults) or a pair."""
    def remove(self, what: type[Any] | Entity, target: type[Any] | Entity | None = None) -> Self: ...
    def has(self, what: type[Any] | Entity, target: type[Any] | Entity | None = None) -> bool: ...
    def get(self, cls: type[_T]) -> _T | None:
        """The component value: a view while a callback runs (writes go to the
        world), else a copy. None if the entity does not have it."""
    def target(self, rel: type[Any] | Entity, index: int = 0) -> Entity | None:
        """The target of relationship `rel` (the first one), or None."""
    def emit(self, event: object) -> None:
        """Emits `event` (a component value or class) on this entity.
        Observers run before this returns."""
    def is_a(self, prefab: Entity) -> Self:
        """Makes this entity an instance of `prefab` (adds `(IsA, prefab)`)."""
    def destruct(self) -> None:
        """Deletes the entity."""
    def enable(self) -> None: ...
    def disable(self) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class WorldRng:
    """The world's seeded RNG: the only randomness a simulation may use."""

    def next_u64(self) -> int: ...
    def next_f32(self) -> float: ...
    def range_f32(self, lo: float, hi: float) -> float: ...
    def next_bool(self) -> bool: ...

class NativeWorld:
    @property
    def script_module(self) -> int: ...
    @property
    def sid_type(self) -> int: ...
    @property
    def rng(self) -> WorldRng: ...
    def entity(self, name: str | None = None, sid: int | None = None) -> Entity: ...
    def lookup(self, sid: int) -> Entity | None: ...
    def lookup_path(self, path: str) -> Entity | None: ...
    def set(self, value: object) -> None: ...
    def get(self, cls: type[_T]) -> _T | None: ...
    def __getattr__(self, name: str) -> Any: ...  # the underscored internals
